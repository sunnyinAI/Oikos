PORT=3001
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
SESSION_EXPIRY_DAYS=30
DEV_OTP_VISIBLE=true
NODE_ENV=development

# ---------- Affiliate program tags (optional) ----------
# Append your affiliate sub_id / campaign tag per vendor. If unset,
# Omni just appends utm_source=omni.
AFFILIATE_TAG_BLINKIT=
AFFILIATE_TAG_ZEPTO=
AFFILIATE_TAG_BIGBASKET=
AFFILIATE_TAG_SWIGGYINSTAMART=
AFFILIATE_TAG_AMAZONFRESH=

# ---------- Web Push / FCM (optional) ----------
# Create a Firebase project (free), add a Web app, enable Cloud Messaging,
# then copy these values from Firebase Console → Project Settings.
#
# - FIREBASE_API_KEY            → web app "apiKey"
# - FIREBASE_PROJECT_ID         → project id (no domain)
# - FIREBASE_MESSAGING_SENDER_ID → cloud messaging "Sender ID"
# - FIREBASE_APP_ID             → web app "App ID" (1:xxx:web:xxx)
# - FIREBASE_VAPID_KEY          → Cloud Messaging → Web Push certificates → Key pair
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# To actually SEND pushes (server-to-device), provide the Firebase service-account.
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Either paste the full JSON inline (one line, escape quotes) OR drop the file at repo
# root as `firebase-service-account.json` and leave both vars empty.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
