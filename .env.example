PORT=3001
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
SESSION_EXPIRY_DAYS=30
# When true, the OTP is returned in the API response and shown on screen
# (no SMS sent) — handy for local dev. Set to false in production to send
# real SMS via MSG91 (see below).
DEV_OTP_VISIBLE=true
NODE_ENV=development

# ---------- SMS / OTP delivery (MSG91) ----------
# Required in production (DEV_OTP_VISIBLE=false) to actually text the code.
# MSG91_TEMPLATE_ID must be a DLT-approved Flow template; MSG91_OTP_VAR is the
# variable name inside that template that receives the 6-digit code.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=OTP
# SMS_COUNTRY_CODE=91

# ---------- Affiliate program tags (optional) ----------
# Append your affiliate sub_id / campaign tag per vendor. If unset,
# Oikos just appends utm_source=oikos.
AFFILIATE_TAG_BLINKIT=
AFFILIATE_TAG_ZEPTO=
AFFILIATE_TAG_BIGBASKET=
AFFILIATE_TAG_SWIGGYINSTAMART=
AFFILIATE_TAG_AMAZONFRESH=

# ---------- Web Push / FCM (optional) ----------
# Create a Firebase project (free), add a Web app, enable Cloud Messaging,
# then copy these values from Firebase Console → Project Settings.
#
# - FIREBASE_API_KEY            → web app "apiKey"
# - FIREBASE_PROJECT_ID         → project id (no domain)
# - FIREBASE_MESSAGING_SENDER_ID → cloud messaging "Sender ID"
# - FIREBASE_APP_ID             → web app "App ID" (1:xxx:web:xxx)
# - FIREBASE_VAPID_KEY          → Cloud Messaging → Web Push certificates → Key pair
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# To actually SEND pushes (server-to-device), provide the Firebase service-account.
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Either paste the full JSON inline (one line, escape quotes) OR drop the file at repo
# root as `firebase-service-account.json` and leave both vars empty.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
