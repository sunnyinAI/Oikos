{
  "name": "kharcha",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "dev:pg": "turbo run dev --filter=@kharcha/web --filter=@kharcha/server",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@kharcha/web",
    "build:client": "npm run build --prefix client",
    "start": "turbo run start --filter=@kharcha/server",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "android:init": "npm run build:client && npx cap add android",
    "android:sync": "npm run build:client && npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "assets": "node scripts/generate-assets.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@google/generative-ai": "^0.24.1"
  }
}
